{
  "name": "ez-php/oauth",
  "version": "2.4.11",
  "description": "OAuth2/SSO client flows: authorization code flow with PKCE and state, token exchange via ez-php/http-client",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Andreas Uretschnig",
      "email": "andreas.uretschnig@gmail.com"
    }
  ],
  "keywords": ["oauth", "oauth2", "sso", "pkce", "authorization-code", "php", "ez-php"],
  "homepage": "https://github.com/ez-php/oauth",
  "support": {
    "issues": "https://github.com/ez-php/oauth/issues",
    "source": "https://github.com/ez-php/oauth"
  },
  "require": {
    "php": "^8.5",
    "ez-php/contracts": "^2.0",
    "ez-php/http-client": "^2.0"
  },
  "require-dev": {
    "ez-php/docker": "^2.0",
    "phpunit/phpunit": "^13.0",
    "phpstan/phpstan": "^2.1",
    "friendsofphp/php-cs-fixer": "^3.94",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpstan/phpstan-deprecation-rules": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "EzPhp\\OAuth\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "cs": "php-cs-fixer fix",
    "analyse": "phpstan analyse",
    "test": "phpunit",
    "full": "composer analyse && composer cs && composer test"
  }
}
